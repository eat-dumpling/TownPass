{
  "name": "taipei-trash-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/copy-shared.mjs && node scripts/gen-icons.mjs",
    "dev": "vite --host --port 5174",
    "prebuild": "node scripts/copy-shared.mjs && node scripts/gen-icons.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4174",
    "pretest": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "typecheck": "node scripts/gen-icons.mjs && vue-tsc --noEmit",
    "fetch:stops": "node scripts/fetch-stops.mjs"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.50.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
